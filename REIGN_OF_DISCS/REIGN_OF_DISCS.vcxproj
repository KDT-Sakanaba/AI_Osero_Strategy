  </ImportGroup>
  <PropertyGroup>
    <LocalDebuggerWorkingDirectory>$(ProjectDir)</LocalDebuggerWorkingDirectory>
    <!-- DxLib is treated as an external (third-party) header directory: its warnings are not ours -->
    <ExternalIncludePath>$(SolutionDir)ThirdParty\DxLib;$(ExternalIncludePath)</ExternalIncludePath>
  </PropertyGroup>
  <ItemDefinitionGroup>
    <ClCompile>
      <ExternalWarningLevel>TurnOffAllWarnings</ExternalWarningLevel>
      <TreatAngleIncludeAsExternal>true</TreatAngleIncludeAsExternal>
      <!-- C4828: DxLib headers are Shift-JIS while sources compile with /utf-8 -->
      <DisableSpecificWarnings>4828;%(DisableSpecificWarnings)</DisableSpecificWarnings>
    </ClCompile>
    <Link>
      <SubSystem>Windows</SubSystem>
      <AdditionalLibraryDirectories>$(SolutionDir)ThirdParty\DxLib;%(AdditionalLibraryDirectories)</AdditionalLibraryDirectories>
      <GenerateDebugInformation>true</GenerateDebugInformation>
    </Link>
  </ItemDefinitionGroup>
  <ItemDefinitionGroup>
    <PostBuildEvent>
      <!-- The game reads Resources next to the exe, wherever it is started from. -->
      <Command>xcopy /E /I /Y /Q "$(ProjectDir)Resources" "$(OutDir)Resources" &gt;nul</Command>
      <Message>Copy Resources to the output folder</Message>
    </PostBuildEvent>
  </ItemDefinitionGroup>
